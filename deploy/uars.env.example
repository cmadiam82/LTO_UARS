# Active authentication provider. Keep LOCAL until the Keycloak authorization-code flow is implemented.
AUTH_PROVIDER=LOCAL

# Future Keycloak OpenID Connect configuration.
KEYCLOAK_ISSUER_URL=https://keycloak.example.gov.ph/realms/lto
KEYCLOAK_CLIENT_ID=lto-uars
KEYCLOAK_CLIENT_SECRET=replace-with-secret
KEYCLOAK_REDIRECT_URI=https://uars.example.gov.ph/api/auth/keycloak/callback
KEYCLOAK_SCOPES=openid profile email
KEYCLOAK_ROLE_CLAIM=realm_access.roles

# Existing runtime settings.
DATABASE_URL=postgresql://user:password@localhost:5432/lto_uars
COOKIE_SECURE=true
UPLOAD_DIR=/opt/lto-uars/shared/uploads
